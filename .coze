[project]
requires = [ "nodejs-24" ]
project_type = "web"
template = "nextjs"
version = "0.0.32"
appliedPatches = [ ]

[dev]
build = [ "pnpm", "install" ]
run = [ "node", "scripts/dev.mjs" ]
validate = [ "pnpm", "run", "build" ]
deps = [ "git" ]

[deploy]
build = [ "pnpm", "install" ]
run = [ "node", "scripts/start.mjs" ]
deps = [ "git" ]